# Required
DATABASE_URL=postgresql://smc:smc@localhost:5433/smc
AUTH_SECRET=change-me            # openssl rand -base64 32
APP_BASE_URL=http://localhost:3000

# Demo hub (/demo) with one-click role sign-in; seeds demo data on first boot when the DB is empty
DEMO_MODE=true

# Optional integrations — leave blank to run offline (emails land in Admin → Email log)
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_MAPS_API_KEY=
PROGRAM_MANAGER_EMAIL=
JOBS_SECRET=
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/New_York
OFFER_LINK_TTL_HOURS=
FEEDBACK_LINK_TTL_DAYS=
