# Local development environment. Never commit real secrets.
DATABASE_URL="postgresql://smc:smc@localhost:5433/smc?schema=public"
AUTH_SECRET="dev-only-change-me-9f3c2b1a7e6d5c4b3a2f1e0d9c8b7a6f"
NEXT_PUBLIC_DEFAULT_TIMEZONE="America/New_York"
AUTH_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
# Email: leave RESEND_API_KEY blank to log emails to the console + notification log instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="Senior Music Connection <bookings@example.com>"
PROGRAM_MANAGER_EMAIL="programs@example.com"
# Geo: leave blank to use the straight-line fallback (haversine x road factor). Set to use Google Geocoding + Distance Matrix.
GOOGLE_MAPS_API_KEY=""
# Inngest (optional locally; `npx inngest-cli@latest dev` to run the dev server)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Shared secret for the manual/cron "run due jobs" endpoint
# Demo hub at /demo with one-click role sign-in and simulated inboxes. Never enable in production.
DEMO_MODE="true"
JOBS_SECRET="dev-jobs-secret"
# Monday.com two-way sync (see docs/MONDAY.md). Leave the token blank to disable the sync entirely.
# The token belongs to a Monday user; use a dedicated "SMC Sync" user before removing whoever set it up.
MONDAY_API_TOKEN=""
# Optional: point at duplicated test boards instead of the live ones (MONDAY_BOARD_<KEY>=<board id>).
# Keys: ENTERTAINERS, CLIENTS, BOOKING_REQUESTS, GIGS, FACILITY_FEEDBACK, ENTERTAINER_FEEDBACK, APPLICATIONS
# MONDAY_BOARD_GIGS=""
# Optional: export every board in the retired workspace instead of the known legacy board ids.
# MONDAY_LEGACY_WORKSPACE_ID=""
