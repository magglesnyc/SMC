{
  "$schema": "https://railway.app/railway.schema.json",
  "deploy": {
    "preDeployCommand": ["npx prisma migrate deploy"],
    "startCommand": "npm run start:railway",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1
  }
}
